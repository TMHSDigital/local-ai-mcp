# Local AI MCP configuration. Every variable is optional; blank means default.
# Never commit a filled-in copy: .env and .env.* are git-ignored.

# --- Local runtimes (always probed) -----------------------------------------
OLLAMA_HOST=http://localhost:11434
LMSTUDIO_HOST=http://localhost:1234
LLAMACPP_HOST=http://localhost:8080
# Docker Desktop: enable "host-side TCP support" for Model Runner.
DOCKER_MODEL_RUNNER_HOST=http://localhost:12434

# --- Opt-in local runtimes (registered only when set) -----------------------
# mlx_lm.server (Apple Silicon). Its default port 8080 collides with llama-server.
MLX_HOST=
# vLLM OpenAI server (`vllm serve`), e.g. http://localhost:8000
VLLM_HOST=
VLLM_API_KEY=
# Foundry Local: the port is dynamic; find it with `foundry service status`.
FOUNDRY_LOCAL_HOST=
# Any other OpenAI-compatible server (Jan, LocalAI, text-generation-webui...).
# Include the /v1 path when the server uses it, e.g. http://localhost:1337/v1
OPENAI_COMPAT_HOST=
OPENAI_COMPAT_API_KEY=

# More instances (e.g. a second GPU box) as a JSON array:
# LOCAL_AI_PROVIDERS=[{"type":"ollama","name":"ollama-gpu2","host":"http://192.168.1.20:11434"}]
LOCAL_AI_PROVIDERS=
# Skip probing runtimes you don't use, by type or name: e.g. lmstudio,dockermodelrunner
LOCAL_AI_DISABLE=

# --- Hosted providers (opt-in) -----------------------------------------------
# Moonshot AI (Kimi). Registered only when a key is set, and never used unless
# a tool call names provider "moonshot" (or LOCAL_AI_ALLOW_HOSTED_FALLBACK=1).
# Get a key at https://platform.kimi.ai/console/api-keys
MOONSHOT_API_KEY=
MOONSHOT_HOST=https://api.moonshot.ai/v1
# Let calls without a provider fall back to hosted providers. Off by default:
# with it off, prompts never leave your machine/network implicitly.
LOCAL_AI_ALLOW_HOSTED_FALLBACK=

# search_models queries the Hugging Face Hub when asked; set to 1 to forbid it.
LOCAL_AI_DISABLE_NETWORK_SEARCH=

# --- Timeouts and caching (ms) -----------------------------------------------
LOCAL_AI_REQUEST_TIMEOUT_MS=120000
LOCAL_AI_DETECT_TIMEOUT_MS=1500
# Model downloads; 0 disables the timeout.
LOCAL_AI_PULL_TIMEOUT_MS=3600000
# Streamed completions abort only if no token arrives for this long.
LOCAL_AI_STREAM_IDLE_TIMEOUT_MS=60000
# Hard cap for a streamed completion; 0 disables.
LOCAL_AI_STREAM_MAX_MS=1800000
# How long provider detection and model lists are cached.
LOCAL_AI_CACHE_TTL_MS=10000
