# Normalize line endings: LF in the repo and on checkout, on every OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gguf binary
*.mcpb binary
*.tgz binary

# Keep generated lockfile out of diff noise in reviews.
package-lock.json linguist-generated=true -diff
