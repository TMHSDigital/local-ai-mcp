{
  "name": "@tmhs/local-ai-mcp",
  "version": "0.5.0",
  "mcpName": "io.github.TMHSDigital/local-ai-mcp",
  "description": "Run, fit, and route work to local LLMs: one MCP server for Ollama, LM Studio, llama.cpp, Docker Model Runner, MLX, vLLM, and Foundry Local, with hardware-aware model selection.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "local-ai-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "gen:tools": "npm run build && node scripts/gen-tools.mjs",
    "prepublishOnly": "npm run build",
    "version": "node scripts/sync-version.mjs && git add server.json mcpb/manifest.json"
  },
  "author": "TMHSDigital",
  "license": "CC-BY-NC-ND-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMHSDigital/local-ai-mcp.git"
  },
  "homepage": "https://tmhsdigital.github.io/local-ai-mcp/",
  "bugs": {
    "url": "https://github.com/TMHSDigital/local-ai-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ollama",
    "lm-studio",
    "llama.cpp",
    "mlx",
    "vllm",
    "docker-model-runner",
    "foundry-local",
    "local-llm",
    "local-ai",
    "gpu",
    "vram",
    "inference",
    "claude",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
